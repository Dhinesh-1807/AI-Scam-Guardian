# AI Scam Guardian - Backend Environment Variables
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# AI Engine Configuration: 'local' (deterministic rules engine) or 'llm' (external AI provider)
AI_PROVIDER=local

# Optional External LLM API (OpenAI / Gemini / Anthropic compatible endpoint)
# If left empty, system automatically falls back to robust localAnalyzer
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_API_BASE=https://api.openai.com/v1

# Supabase PostgreSQL Configuration
# If left empty, backend uses in-memory demo database with persistent local state
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
